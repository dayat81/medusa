# Simple Medusa Dockerfile for development
FROM node:20-alpine

# Install dependencies
RUN apk add --no-cache ca-certificates

# Create app directory
WORKDIR /app

# Copy package.json and install a minimal medusa setup
RUN npm install -g @medusajs/cli@latest

# Create a simple medusa project structure
RUN medusa new medusa-store --skip-db --skip-env

# Copy over our configuration
WORKDIR /app/medusa-store

# Create a simple entrypoint script
RUN echo '#!/bin/sh\n\
echo "Starting Medusa..."\n\
if [ "$MEDUSA_WORKER_MODE" = "worker" ]; then\n\
  echo "Running in worker mode"\n\
  exec npx medusa start --worker\n\
else\n\
  echo "Running in server mode"\n\
  exec npx medusa start\n\
fi' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

EXPOSE 9000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:9000/health || exit 1

CMD ["/app/entrypoint.sh"]