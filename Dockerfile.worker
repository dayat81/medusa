# Medusa Worker Dockerfile
FROM node:20-alpine AS base

# Install build dependencies
RUN apk add --no-cache python3 make g++ git

# Set working directory
WORKDIR /app

# Copy the entire project (simpler approach for development)
COPY . .

# Install dependencies using yarn workspaces
RUN yarn install --frozen-lockfile

# Build the application
RUN yarn build

# Production stage
FROM node:20-alpine AS production

# Install runtime dependencies
RUN apk add --no-cache ca-certificates

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S medusa -u 1001

# Set working directory
WORKDIR /app

# Copy built application from base stage
COPY --from=base --chown=medusa:nodejs /app ./

# Create data directory
RUN mkdir -p /app/data && chown medusa:nodejs /app/data

# Switch to non-root user
USER medusa

# Set environment variable to run in worker mode
ENV MEDUSA_WORKER_MODE=worker

# Health check for worker (checks if process is running)
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD pgrep -f "node.*start" > /dev/null || exit 1

# Start in worker mode
CMD ["node", "packages/medusa/dist/index.js", "start"]